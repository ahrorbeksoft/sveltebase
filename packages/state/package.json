{
  "name": "@sveltebase/state",
  "version": "0.4.5",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@sveltebase/utils": "0.4.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahrorbeksoft/sveltebase.git",
    "directory": "packages/state"
  },
  "bugs": {
    "url": "https://github.com/ahrorbeksoft/sveltebase/issues"
  },
  "homepage": "https://github.com/ahrorbeksoft/sveltebase/tree/main/packages/state#readme",
  "scripts": {
    "build": "svelte-package --input ./src --output ./dist",
    "check": "tsc --project tsconfig.json --noEmit",
    "lint": "bun run build && publint --strict --pack npm",
    "clean": "rm -rf dist"
  }
}
