{
  "name": "@sveltebase/state",
  "version": "2.0.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@sveltebase/utils": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5.46.4 <6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahrorbeksoft/sveltebase.git",
    "directory": "packages/state"
  },
  "bugs": {
    "url": "https://github.com/ahrorbeksoft/sveltebase/issues"
  },
  "homepage": "https://github.com/ahrorbeksoft/sveltebase/tree/main/packages/state#readme",
  "scripts": {
    "build": "svelte-package --input ./src --output ./dist --tsconfig ./tsconfig.package.json",
    "check": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts packages/state",
    "lint": "bun run build && publint --strict --pack npm",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "svelte": "5.57.0"
  }
}
