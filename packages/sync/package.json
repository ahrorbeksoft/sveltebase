{
  "name": "@sveltebase/sync",
  "version": "2.0.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "svelte": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/dev-engine": {
      "types": "./dist/server/dev-engine.d.ts",
      "default": "./dist/server/dev-engine.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "default": "./dist/sveltekit/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "dependencies": {
    "dexie": "4.4.5",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "svelte": ">=5.46.4 <6",
    "@sveltejs/kit": "^2.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.129.0"
  },
  "scripts": {
    "build": "svelte-package --input ./src --output ./dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts packages/sync",
    "lint": "publint --strict --pack npm"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    }
  },
  "devDependencies": {
    "wrangler": "4.129.0",
    "svelte": "5.57.0"
  }
}
