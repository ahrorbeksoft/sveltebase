{
  "name": "@sveltebase/auth",
  "version": "1.7.11",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "svelte": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "default": "./dist/sveltekit/index.js"
    },
    "./google": {
      "types": "./dist/google/index.d.ts",
      "svelte": "./dist/google/index.js",
      "default": "./dist/google/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@sveltejs/kit": "^2.0.0"
  },
  "devDependencies": {
    "@types/google.accounts": "^0.0.14",
    "@tanstack/intent": "^0.4.0"
  },
  "scripts": {
    "build": "svelte-package --input ./src --output ./dist --tsconfig ./tsconfig.package.json",
    "check": "tsc --project tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/sync-skills.mjs --check && intent validate skills --check"
  },
  "keywords": [
    "tanstack-intent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahrorbeksoft/sveltebase.git",
    "directory": "packages/auth"
  }
}
