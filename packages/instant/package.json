{
  "name": "@sveltebase/instant",
  "version": "0.5.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahrorbeksoft/sveltebase.git",
    "directory": "packages/instant"
  },
  "bugs": {
    "url": "https://github.com/ahrorbeksoft/sveltebase/issues"
  },
  "homepage": "https://github.com/ahrorbeksoft/sveltebase/tree/main/packages/instant#readme",
  "peerDependencies": {
    "@instantdb/svelte": "^1.0.17",
    "@sveltejs/kit": "^2.58.0",
    "svelte": "^5.55.5"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@instantdb/svelte": "^1.0.17"
  },
  "scripts": {
    "build": "svelte-package --input ./src --output ./dist",
    "check": "tsc --project tsconfig.json --noEmit",
    "lint": "bun run build && publint --strict --pack npm",
    "clean": "rm -rf dist"
  }
}
