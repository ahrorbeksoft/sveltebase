{
  "name": "@sveltebase/i18n",
  "version": "2.0.1",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "dependencies": {
    "intl-messageformat": "11.2.0"
  },
  "peerDependencies": {
    "svelte": ">=5.46.4 <6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahrorbeksoft/sveltebase.git",
    "directory": "packages/i18n"
  },
  "bugs": {
    "url": "https://github.com/ahrorbeksoft/sveltebase/issues"
  },
  "homepage": "https://github.com/ahrorbeksoft/sveltebase/tree/main/packages/i18n",
  "scripts": {
    "build": "tsup src/index.ts src/core.ts --format esm --dts --clean",
    "check": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts packages/i18n",
    "lint": "bun run build && publint --strict --pack npm",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "svelte": "5.57.0"
  }
}
