{
  "name": "@sveltebase/i18n",
  "version": "1.7.11",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@sveltebase/state": "1.7.11",
    "use-intl": "^4.14.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahrorbeksoft/sveltebase.git",
    "directory": "packages/i18n"
  },
  "bugs": {
    "url": "https://github.com/ahrorbeksoft/sveltebase/issues"
  },
  "homepage": "https://github.com/ahrorbeksoft/sveltebase/tree/main/packages/i18n",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "check": "tsc --project tsconfig.json --noEmit",
    "lint": "bun run build && publint --strict --pack npm",
    "clean": "rm -rf dist",
    "test": "vitest run --root ../.. packages/i18n/tests",
    "prepack": "node ../../scripts/sync-skills.mjs --check && intent validate skills --check"
  },
  "keywords": [
    "tanstack-intent"
  ],
  "devDependencies": {
    "@tanstack/intent": "^0.4.0"
  }
}
