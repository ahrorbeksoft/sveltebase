{
  "name": "@sveltebase/utils",
  "version": "1.7.11",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahrorbeksoft/sveltebase.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/ahrorbeksoft/sveltebase/issues"
  },
  "homepage": "https://github.com/ahrorbeksoft/sveltebase/tree/main/packages/utils#readme",
  "peerDependencies": {
    "svelte": "^5.0.0",
    "svelte-sonner": "^1.1.1"
  },
  "dependencies": {
    "esm-env": "^1.2.2"
  },
  "devDependencies": {
    "svelte-sonner": "^1.2.1",
    "@tanstack/intent": "^0.4.0"
  },
  "scripts": {
    "build": "svelte-package --input ./src --output ./dist",
    "check": "tsc --project tsconfig.json --noEmit",
    "lint": "bun run build && publint --strict --pack npm",
    "clean": "rm -rf dist",
    "test": "vitest run --root ../.. packages/utils/tests",
    "prepack": "node ../../scripts/sync-skills.mjs --check && intent validate skills --check"
  },
  "keywords": [
    "tanstack-intent"
  ]
}
