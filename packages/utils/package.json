{
  "name": "@sveltebase/utils",
  "version": "2.0.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cookies": {
      "types": "./dist/cookies.d.ts",
      "default": "./dist/cookies.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "default": "./dist/notifications.js"
    },
    "./async": {
      "types": "./dist/async.svelte.d.ts",
      "svelte": "./dist/async.svelte.js",
      "default": "./dist/async.svelte.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahrorbeksoft/sveltebase.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/ahrorbeksoft/sveltebase/issues"
  },
  "homepage": "https://github.com/ahrorbeksoft/sveltebase/tree/main/packages/utils#readme",
  "peerDependencies": {
    "svelte": ">=5.46.4 <6"
  },
  "scripts": {
    "build": "svelte-package --input ./src --output ./dist",
    "check": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts packages/utils",
    "lint": "bun run build && publint --strict --pack npm",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "svelte": "5.57.0"
  }
}
